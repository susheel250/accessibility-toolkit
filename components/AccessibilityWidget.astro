---
// src/components/AccessibilityWidget.astro
// Supported EmDash Host Integration for Accessibility Toolkit
// Loads dynamic configuration from the installed plugin and mounts the accessibility widget

import { getDb } from "emdash/runtime";
import { getPluginSettings } from "emdash";

interface Props {
  pluginId?: string;
  standalone?: boolean;
  enabled?: boolean;
  language?: string;
  primaryColor?: string;
  iconId?: "default" | "accessibility" | "assist" | "wheel";
  iconSize?: number;
  positionDesktop?: "bottom-right" | "bottom-left" | "top-right" | "top-left";
  positionMobile?: "bottom-right" | "bottom-left" | "top-right" | "top-left";
  statementUrl?: string;
  cdnBaseUrl?: string;
  scriptSrc?: string;
  cdnSrc?: string;
  fontsUrl?: string;
  integrity?: string;
  companyName?: string;
  website?: string;
}

const {
  pluginId: propPluginId = "",
  standalone = false,
  enabled = true,
  language = "en",
  primaryColor = "#1863DC",
  iconId = "default",
  iconSize = 48,
  positionDesktop = "bottom-right",
  positionMobile = "bottom-right",
  statementUrl = "",
  cdnBaseUrl = "https://cdn.jsdelivr.net/gh/susheel250/accessibility-toolkit@v1.3.5/vendor/accessibility-toolkit/",
  scriptSrc = "/vendor/accessibility-toolkit/js/widget.min.js",
  cdnSrc = "",
  fontsUrl = "",
  integrity = "sha384-PkHCo9yYYt43CM9mczXrTqkNN0ddgEpZos0hrTEP62/Iox7z6iWI3CfR06lzbWdK",
  companyName = "",
  website = "",
} = Astro.props;

// Dynamically resolve installed Registry plugin ID without hardcoding
let activePluginId = (propPluginId || "").trim();
let isPluginActive = true;
let isPluginExplicitlyDisabled = false;
let savedSettings: Record<string, any> | null = null;

if (!activePluginId) {
  const envId = (import.meta.env.PUBLIC_ACCESSIBILITY_PLUGIN_ID || import.meta.env.ACCESSIBILITY_PLUGIN_ID || "").trim();
  if (envId) {
    activePluginId = envId;
  } else {
    try {
      const db = await getDb();
      if (db) {
        const row = await db
          .selectFrom("_plugin_state")
          .select(["plugin_id", "status", "registry_slug", "display_name"])
          .where((eb: any) =>
            eb.or([
              eb("registry_slug", "=", "accessibility-toolkit"),
              eb("plugin_id", "=", "accessibility-toolkit"),
              eb.and([
                eb("plugin_id", "like", "r_%"),
                eb.or([
                  eb("display_name", "like", "%Accessibility%"),
                  eb("registry_slug", "like", "%accessibility%"),
                ]),
              ]),
            ])
          )
          .where("status", "=", "active")
          .executeTakeFirst();

        if (row?.plugin_id) {
          activePluginId = row.plugin_id;
        } else {
          isPluginActive = false;
        }
      }
    } catch {
      // In case DB is unavailable during certain SSR phases, do not hard fail
    }
  }
}

// If we resolved an active plugin ID, check saved plugin settings to verify enablement
if (activePluginId) {
  try {
    savedSettings = await getPluginSettings(activePluginId);
    if (savedSettings && typeof savedSettings === "object") {
      if (savedSettings.enabled === false) {
        isPluginExplicitlyDisabled = true;
      }
    }
  } catch {
    // If getPluginSettings fails, the client loader will still check the endpoint
  }
}

// In standard plugin mode:
// 1. Must be enabled via prop
// 2. Not explicitly disabled in plugin admin settings
// 3. Either standalone mode, or active plugin detected
const shouldRender = enabled && !isPluginExplicitlyDisabled && (standalone || (isPluginActive && Boolean(activePluginId)));

const activePrimaryColor = savedSettings?.primaryColor ?? primaryColor;
const activeIconId = savedSettings?.iconId ?? iconId;
const activeIconSize = Number(savedSettings?.iconSize ?? iconSize);
const activePosDesktop = savedSettings?.positionDesktop ?? positionDesktop;
const activePosMobile = savedSettings?.positionMobile ?? positionMobile;
const activeLanguage = savedSettings?.language ?? language;
const activeCdnBaseUrl = savedSettings?.cdnBaseUrl ?? cdnBaseUrl;
const activeStatementUrl = savedSettings?.statementUrl ?? statementUrl;

const config = {
  status: {
    mobile: true,
    desktop: true,
  },
  iconId: activeIconId,
  iconSize: activeIconSize,
  label: "Accessibility menu",
  heading: "Accessibility Toolkit",
  position: {
    mobile: activePosMobile,
    desktop: activePosDesktop,
  },
  language: {
    default: activeLanguage,
    selected: [],
  },
  margins: {
    desktop: { top: 20, bottom: 20, left: 20, right: 20 },
    mobile: { top: 20, bottom: 20, left: 20, right: 20 },
  },
  primaryColor: activePrimaryColor,
  keyboard: {
    enabled: true,
    shortcut: "alt+a",
  },
  modules: {
    color: {
      darkContrast: { enabled: true },
      lightContrast: { enabled: true },
      highContrast: { enabled: true },
      highSaturation: { enabled: true },
      lowSaturation: { enabled: true },
      monochrome: { enabled: true },
    },
    content: {
      adjustFontSizing: { enabled: true },
      highlightTitle: { enabled: true },
      highlightLinks: { enabled: true },
      dyslexicFont: { enabled: true },
      letterSpacing: { enabled: true },
      lineHeight: { enabled: true },
      fontWeight: { enabled: true },
      textAlign: { enabled: true },
    },
    navigation: {
      readingGuide: { enabled: true },
      pauseAnimations: { enabled: true },
      bigCursor: { enabled: true },
    },
    statement: {
      enabled: Boolean(activeStatementUrl),
      url: activeStatementUrl,
      displayInWidget: false,
      generatedDate: "",
      formData: {
        companyName: companyName,
        businessEmail: "",
        website: website,
        wcagStandard: "WCAG 2.2 Level AA",
        conformanceStatus: "fully-conformant",
      },
    },
    profiles: { enabled: true },
    pageRead: { enabled: true },
    muteSounds: { enabled: true },
  },
};
---

{shouldRender && (
  <script is:inline id="accessibility-toolkit-loader" data-plugin-id={activePluginId} define:vars={{ config, cdnBaseUrl: activeCdnBaseUrl, fontsUrl, scriptSrc, cdnSrc, integrity, pluginId: activePluginId, standalone }}>
    // @ts-nocheck
    (function() {
      // Prevent duplicate script loading and initialization
      if (window.__accessibility_toolkit_initialized) {
        return;
      }
      if (document.getElementById("accessibility-toolkit-script")) {
        return;
      }
      window.__accessibility_toolkit_initialized = true;

      function sanitizeCdn(val) {
        if (!val || typeof val !== "string") return "";
        var t = val.trim();
        if (!t || t.toLowerCase() === "local" || t.toLowerCase() === "none") return "";
        if (t.toLowerCase() === "default") return "https://cdn.jsdelivr.net/gh/susheel250/accessibility-toolkit@v1.3.5/vendor/accessibility-toolkit/";
        try {
          var u = new URL(t);
          if (u.protocol !== "https:") return "";
          u.search = "";
          u.hash = "";
          var low = u.href.toLowerCase();
          if (low.indexOf("coddle-accessibility") !== -1 || low.indexOf("coddle-access") !== -1 || low.indexOf("@v1.3.4") !== -1 || low.indexOf("@v1.3.6") !== -1) {
            return "https://cdn.jsdelivr.net/gh/susheel250/accessibility-toolkit@v1.3.5/vendor/accessibility-toolkit";
          }
          var p = u.pathname.replace(/[/]+(js([/]widget([.]min)?[.]js)?|fonts)[/]?$/, "").replace(/[/]+$/, "");
          return u.origin + p;
        } catch(e) {
          return "";
        }
      }

      function applyShadowOverrides() {
        var container = document.getElementById("cya11y-container");
        if (!container || !container.shadowRoot) return false;
        var sr = container.shadowRoot;
        if (!sr.getElementById("a11y-toolkit-overrides")) {
          var style = document.createElement("style");
          style.id = "a11y-toolkit-overrides";
          style.textContent = [
            ".cya11y-footer-brand { display: none !important; }",
            ".cya11y-footer:not(:has(.cya11y-footer-statement-link:not([style*='display: none']):not([style*='display:none']))) { display: none !important; }"
          ].join(" ");
          sr.appendChild(style);

          var btn = sr.querySelector(".cya11y-menu-btn");
          if (btn) {
            btn.setAttribute("aria-label", "Accessibility menu");
            btn.setAttribute("title", "Accessibility menu");
          }

          var syncFooter = function() {
            var footer = sr.querySelector(".cya11y-footer");
            if (!footer) return;
            var statement = footer.querySelector(".cya11y-footer-statement-link");
            var hasStatement = statement && window.getComputedStyle(statement).display !== "none";
            if (!hasStatement) {
              footer.style.display = "none";
            }
          };

          var footerObserver = new MutationObserver(syncFooter);
          footerObserver.observe(sr, { childList: true, subtree: true });
        }
        return true;
      }

      function mountWidget(activeConfig) {
        window._cyA11yConfig = activeConfig || config;

        var activeCdnBase = sanitizeCdn((activeConfig && activeConfig.cdnBaseUrl) || cdnBaseUrl);
        var activeFontsUrl = (activeConfig && activeConfig.fontsUrl) || fontsUrl;
        if (!activeFontsUrl) {
          activeFontsUrl = activeCdnBase ? activeCdnBase + "/fonts/" : "/vendor/accessibility-toolkit/fonts/";
        }

        window._cyA11yAssets = {
          fonts: activeFontsUrl
        };

        if (document.getElementById("accessibility-toolkit-script") || document.getElementById("accessibility-toolkit-script-fallback")) {
          return;
        }

        // Determine primary and fallback script URLs
        var primarySrc = scriptSrc;
        var fallbackSrc = "";
        var useSri = false;

        if (cdnSrc) {
          primarySrc = cdnSrc;
          fallbackSrc = scriptSrc;
          useSri = true;
        } else if (activeConfig && activeConfig.scriptUrl) {
          primarySrc = activeConfig.scriptUrl;
          fallbackSrc = activeConfig.cdnConfigured ? "/vendor/accessibility-toolkit/js/widget.min.js" : "";
          useSri = Boolean(activeConfig.cdnConfigured);
        } else if (activeCdnBase) {
          primarySrc = activeCdnBase + "/js/widget.min.js";
          fallbackSrc = "/vendor/accessibility-toolkit/js/widget.min.js";
          useSri = true;
        }

        var script = document.createElement("script");
        script.id = "accessibility-toolkit-script";
        script.type = "text/javascript";
        script.src = primarySrc;
        script.async = true;

        if (useSri && integrity) {
          script.integrity = integrity;
          script.crossOrigin = "anonymous";
        }

        script.onerror = function() {
          if (fallbackSrc && fallbackSrc !== primarySrc) {
            if (document.getElementById("accessibility-toolkit-script-fallback")) return;
            console.warn("[Accessibility Toolkit] Primary script failed to load from " + primarySrc + ", attempting local fallback: " + fallbackSrc);
            var fallback = document.createElement("script");
            fallback.id = "accessibility-toolkit-script-fallback";
            fallback.type = "text/javascript";
            fallback.src = fallbackSrc;
            fallback.async = true;
            fallback.onerror = function() {
              window.__accessibility_toolkit_initialized = false;
              console.warn("[Accessibility Toolkit] Both primary (" + primarySrc + ") and fallback (" + fallbackSrc + ") failed to load. Ensure assets exist in public/vendor/accessibility-toolkit/ or check CDN availability.");
            };
            (document.body || document.head).appendChild(fallback);
          } else {
            window.__accessibility_toolkit_initialized = false;
            console.warn("[Accessibility Toolkit] Widget script failed to load from " + primarySrc + ". Ensure assets exist in public/vendor/accessibility-toolkit/ or configure a valid CDN URL.");
          }
        };

        if (!applyShadowOverrides()) {
          var obs = new MutationObserver(function() {
            if (applyShadowOverrides()) {
              obs.disconnect();
            }
          });
          obs.observe(document.body || document.documentElement, { childList: true, subtree: true });
          setTimeout(function() {
            obs.disconnect();
          }, 30000);
        }

        (document.body || document.head).appendChild(script);
      }

      // Candidate API endpoints for plugin settings (supports registry ID, slug, and legacy aliases)
      var endpoints = [];
      if (pluginId) {
        endpoints.push("/_emdash/api/plugins/" + encodeURIComponent(pluginId) + "/config");
      }
      endpoints.push(
        "/_emdash/api/plugins/accessibility-toolkit/config",
        "/_emdash/api/plugins/accessibility/config"
      );

      function tryEndpoint(idx) {
        if (idx >= endpoints.length) {
          if (standalone) {
            // Explicit opt-in for standalone mode without backend plugin
            mountWidget(config);
          } else {
            // In standard plugin mode: uninstalled or unreachable, do not mount
            window.__accessibility_toolkit_initialized = false;
            console.warn("[Accessibility Toolkit] No active configuration endpoint responded (" + endpoints.join(", ") + "). Widget will not be mounted.");
          }
          return;
        }
        fetch(endpoints[idx])
          .then(function(r) {
            if (!r.ok) throw new Error("status " + r.status);
            return r.json();
          })
          .then(function(res) {
            var data = (res && res.data) || (res && res.settings) || res;
            if (data && typeof data === "object") {
              // Master toggle check: if disabled in plugin settings, halt immediately
              if (data.enabled === false) {
                window.__accessibility_toolkit_initialized = false;
                console.info("[Accessibility Toolkit] Plugin is installed but explicitly disabled in settings.");
                return;
              }
              var merged = JSON.parse(JSON.stringify(config));
              if (data.primaryColor) merged.primaryColor = data.primaryColor;
              if (data.iconId) merged.iconId = data.iconId;
              if (data.iconSize) merged.iconSize = Number(data.iconSize);
              if (data.positionDesktop) merged.position.desktop = data.positionDesktop;
              if (data.positionMobile) merged.position.mobile = data.positionMobile;
              if (data.language) merged.language.default = data.language;
              if (data.cdnBaseUrl !== undefined) merged.cdnBaseUrl = data.cdnBaseUrl;
              if (data.cdnConfigured !== undefined) merged.cdnConfigured = data.cdnConfigured;
              if (data.scriptUrl) merged.scriptUrl = data.scriptUrl;
              if (data.fontsUrl) merged.fontsUrl = data.fontsUrl;
              if (data.statementUrl) {
                merged.modules.statement.enabled = true;
                merged.modules.statement.url = data.statementUrl;
              }
              mountWidget(merged);
            } else {
              tryEndpoint(idx + 1);
            }
          })
          .catch(function() {
            tryEndpoint(idx + 1);
          });
      }

      tryEndpoint(0);
    })();
  </script>
)}
