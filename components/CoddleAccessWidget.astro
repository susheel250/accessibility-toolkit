---
// components/CoddleAccessWidget.astro
// Backward-compatibility wrapper for AccessibilityWidget.astro
import AccessibilityWidget from "./AccessibilityWidget.astro";

interface Props {
  pluginId?: string;
  enabled?: boolean;
  language?: string;
  primaryColor?: string;
  iconId?: "default" | "accessibility" | "assist" | "wheel";
  iconSize?: number;
  positionDesktop?: "bottom-right" | "bottom-left" | "top-right" | "top-left";
  positionMobile?: "bottom-right" | "bottom-left" | "top-right" | "top-left";
  statementUrl?: string;
  scriptSrc?: string;
  cdnSrc?: string;
  fontsUrl?: string;
  companyName?: string;
  website?: string;
}
---

<AccessibilityWidget {...Astro.props} />

