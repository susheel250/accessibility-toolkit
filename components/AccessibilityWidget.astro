---
// components/AccessibilityWidget.astro
// Supported EmDash Host Integration for Accessibility Toolkit
// Loads dynamic configuration from the installed plugin and mounts the accessibility widget

interface Props {
  pluginId?: string;
  enabled?: boolean;
  language?: string;
  primaryColor?: string;
  iconId?: "default" | "accessibility" | "assist" | "wheel";
  iconSize?: number;
  positionDesktop?: "bottom-right" | "bottom-left" | "top-right" | "top-left";
  positionMobile?: "bottom-right" | "bottom-left" | "top-right" | "top-left";
  statementUrl?: string;
  scriptSrc?: string;
  cdnSrc?: string;
  fontsUrl?: string;
  integrity?: string;
  companyName?: string;
  website?: string;
}

const {
  pluginId = "r_rznxjv6huupd4i7d",
  enabled = true,
  language = "en",
  primaryColor = "#1863DC",
  iconId = "default",
  iconSize = 48,
  positionDesktop = "bottom-right",
  positionMobile = "bottom-right",
  statementUrl = "",
  scriptSrc = "/vendor/accessibility-toolkit/js/widget.min.js",
  cdnSrc = "",
  fontsUrl = "/vendor/accessibility-toolkit/fonts/",
  integrity = "sha384-PkHCo9yYYt43CM9mczXrTqkNN0ddgEpZos0hrTEP62/Iox7z6iWI3CfR06lzbWdK",
  companyName = "",
  website = "",
} = Astro.props;

const config = {
  status: {
    mobile: true,
    desktop: true,
  },
  iconId: iconId,
  iconSize: Number(iconSize),
  label: "Accessibility widget",
  heading: "Accessibility Toolkit",
  position: {
    mobile: positionMobile,
    desktop: positionDesktop,
  },
  language: {
    default: language,
    selected: [],
  },
  margins: {
    desktop: { top: 20, bottom: 20, left: 20, right: 20 },
    mobile: { top: 20, bottom: 20, left: 20, right: 20 },
  },
  primaryColor: primaryColor,
  keyboard: {
    enabled: true,
    shortcut: "alt+a",
  },
  modules: {
    color: {
      darkContrast: { enabled: true },
      lightContrast: { enabled: true },
      highContrast: { enabled: true },
      highSaturation: { enabled: true },
      lowSaturation: { enabled: true },
      monochrome: { enabled: true },
    },
    content: {
      adjustFontSizing: { enabled: true },
      highlightTitle: { enabled: true },
      highlightLinks: { enabled: true },
      dyslexicFont: { enabled: true },
      letterSpacing: { enabled: true },
      lineHeight: { enabled: true },
      fontWeight: { enabled: true },
      textAlign: { enabled: true },
    },
    navigation: {
      readingGuide: { enabled: true },
      pauseAnimations: { enabled: true },
      bigCursor: { enabled: true },
    },
    statement: {
      enabled: Boolean(statementUrl),
      url: statementUrl,
      displayInWidget: false,
      generatedDate: "",
      formData: {
        companyName: companyName,
        businessEmail: "",
        website: website,
        wcagStandard: "WCAG 2.2 Level AA",
        conformanceStatus: "fully-conformant",
      },
    },
    profiles: { enabled: true },
    pageRead: { enabled: true },
    muteSounds: { enabled: true },
  },
};
---

{enabled && (
  <script is:inline define:vars={{ config, fontsUrl, scriptSrc, cdnSrc, integrity, pluginId }}>
    // @ts-nocheck
    (function() {
      // Prevent duplicate script loading and initialization
      if (window.__accessibility_toolkit_initialized || window.__coddle_access_initialized || window.__accessiyes_initialized) {
        return;
      }
      window.__accessibility_toolkit_initialized = true;
      window.__coddle_access_initialized = true;
      window.__accessiyes_initialized = true;

      function mountWidget(activeConfig) {
        window._cyA11yConfig = activeConfig || config;

        // Resolve fonts URL: custom fontsUrl > activeConfig.cdnBaseUrl > default
        var activeFontsUrl = fontsUrl;
        if (activeConfig && activeConfig.cdnBaseUrl && activeConfig.cdnBaseUrl.startsWith("https://") && (fontsUrl === "/vendor/accessibility-toolkit/fonts/" || fontsUrl === "/vendor/coddle-access/fonts/")) {
          activeFontsUrl = activeConfig.cdnBaseUrl.replace(/\/+$/, "") + "/fonts/";
        }
        window._cyA11yAssets = {
          fonts: activeFontsUrl
        };

        if (document.getElementById("accessibility-toolkit-script") || document.getElementById("coddle-access-script")) {
          return;
        }

        // Determine primary and fallback script URLs
        var primarySrc = scriptSrc;
        var fallbackSrc = "";
        var useSri = false;

        if (cdnSrc) {
          primarySrc = cdnSrc;
          fallbackSrc = scriptSrc;
          useSri = true;
        } else if (activeConfig && activeConfig.cdnBaseUrl && activeConfig.cdnBaseUrl.startsWith("https://")) {
          primarySrc = activeConfig.cdnBaseUrl.replace(/\/+$/, "") + "/js/widget.min.js";
          fallbackSrc = scriptSrc;
          useSri = true;
        }

        var script = document.createElement("script");
        script.id = "accessibility-toolkit-script";
        script.type = "text/javascript";
        script.src = primarySrc;
        script.async = true;

        if (useSri && integrity) {
          script.integrity = integrity;
          script.crossOrigin = "anonymous";
        }

        script.onerror = function() {
          if (fallbackSrc) {
            console.warn("[Accessibility Toolkit] Primary script failed to load from " + primarySrc + ", attempting local fallback: " + fallbackSrc);
            var fallback = document.createElement("script");
            fallback.id = "accessibility-toolkit-script-fallback";
            fallback.type = "text/javascript";
            fallback.src = fallbackSrc;
            fallback.async = true;
            fallback.onerror = function() {
              console.warn("[Accessibility Toolkit] Both primary (" + primarySrc + ") and fallback (" + fallbackSrc + ") failed to load. Ensure assets exist in public/vendor/accessibility-toolkit/ (or legacy public/vendor/coddle-access/) or check CDN availability.");
            };
            (document.body || document.head).appendChild(fallback);
          } else {
            console.warn("[Accessibility Toolkit] Widget script failed to load from " + primarySrc + ". To use local assets, ensure files exist in public/vendor/accessibility-toolkit/ (or legacy public/vendor/coddle-access/) or configure a valid CDN URL.");
          }
        };

        (document.body || document.head).appendChild(script);
      }

      // Candidate API endpoints for plugin settings (supports registry ID, slug, and legacy aliases)
      var endpoints = [];
      if (pluginId) {
        endpoints.push("/_emdash/api/plugins/" + encodeURIComponent(pluginId) + "/config");
      }
      endpoints.push(
        "/_emdash/api/plugins/accessibility-toolkit/config",
        "/_emdash/api/plugins/accessibility/config"
      );

      function tryEndpoint(idx) {
        if (idx >= endpoints.length) {
          if (pluginId) {
            console.warn("[Accessibility Toolkit] Plugin endpoint unreachable for pluginId: " + pluginId + ". Widget will not be mounted.");
            return;
          }
          // In standalone mode (no pluginId), mount with component props
          mountWidget(config);
          return;
        }
        fetch(endpoints[idx])
          .then(function(r) {
            if (!r.ok) throw new Error("status " + r.status);
            return r.json();
          })
          .then(function(res) {
            var data = (res && res.data) || (res && res.settings) || res;
            if (data && typeof data === "object") {
              // Master toggle check: if disabled in plugin settings, halt immediately
              if (data.enabled === false) {
                return;
              }
              var merged = JSON.parse(JSON.stringify(config));
              if (data.primaryColor) merged.primaryColor = data.primaryColor;
              if (data.iconId) merged.iconId = data.iconId;
              if (data.iconSize) merged.iconSize = Number(data.iconSize);
              if (data.positionDesktop) merged.position.desktop = data.positionDesktop;
              if (data.positionMobile) merged.position.mobile = data.positionMobile;
              if (data.language) merged.language.default = data.language;
              if (data.cdnBaseUrl) merged.cdnBaseUrl = data.cdnBaseUrl;
              if (data.statementUrl) {
                merged.modules.statement.enabled = true;
                merged.modules.statement.url = data.statementUrl;
              }
              mountWidget(merged);
            } else {
              tryEndpoint(idx + 1);
            }
          })
          .catch(function() {
            tryEndpoint(idx + 1);
          });
      }

      tryEndpoint(0);
    })();
  </script>
)}
