{
	"name": "accessibility-toolkit",
	"version": "1.3.4",
	"description": "Accessibility Toolkit - Accessible, lightweight, customizable web accessibility widget for EmDash CMS",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.16.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs",
		"./widget": "./components/AccessibilityWidget.astro",
		"./accessibility-widget": "./components/AccessibilityWidget.astro",
		"./coddle-access-widget": "./components/CoddleAccessWidget.astro",
		"./admin": "./admin/admin.tsx"
	},
	"files": [
		"dist",
		"!dist/*.tar.gz",
		"!dist/*.tgz",
		"emdash-plugin.jsonc",
		"README.md",
		"REGISTRY-INSTALLATION.md",
		"CHANGELOG.md",
		"LICENSE",
		"icon.png",
		"screenshots",
		"vendor",
		"components",
		"admin"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.mjs",
		"bundle": "emdash-plugin bundle"
	},
	"peerDependencies": {
		"emdash": ">=0.12.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.3",
		"emdash": ">=0.12.0 <2.0.0",
		"typescript": "^5.9.0"
	},
	"author": "Accessibility Toolkit Contributors <a11y@emdashcms.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/susheel250/accessibility-toolkit.git"
	}
}
