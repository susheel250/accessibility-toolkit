{
	"$schema": "https://raw.githubusercontent.com/emdash-cms/emdash/main/packages/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "coddle-access",
	"publisher": "did:plc:pcngdskjcwsettdojdho2dtr",
	"version": "1.3.0",
	"license": "MIT",

	"name": "Coddle Accessibility Toolkit",
	"description": "Comprehensive web accessibility toolkit for EmDash CMS websites - WCAG 2.2 AA and ADA Section 508 compliance.",
	"keywords": ["accessibility", "a11y", "wcag", "coddle", "compliance"],

	"author": {
		"name": "Coddle Technologies",
		"url": "https://coddletech.com",
		"email": "info@coddletech.com"
	},
	"security": {
		"email": "security@coddletech.com",
		"url": "https://coddletech.com/security"
	},
	"repo": "https://github.com/coddletech/coddle-access",

	"capabilities": [],
	"allowedHosts": [],
	"storage": {},

	"admin": {
		"pages": [
			{
				"path": "/settings",
				"label": "Coddle Accessibility",
				"icon": "accessibility"
			}
		],
		"settingsSchema": {
			"enabled": {
				"type": "boolean",
				"label": "Enable Accessibility Widget",
				"description": "Toggle the public Coddle Access widget on or off.",
				"default": true
			},
			"language": {
				"type": "select",
				"label": "Widget Language",
				"description": "Default interface language for the Coddle Accessibility menu.",
				"options": [
					{ "value": "en", "label": "English" },
					{ "value": "es", "label": "Spanish (Español)" },
					{ "value": "fr", "label": "French (Français)" },
					{ "value": "de", "label": "German (Deutsch)" },
					{ "value": "it", "label": "Italian (Italiano)" },
					{ "value": "pt", "label": "Portuguese (Português)" },
					{ "value": "nl", "label": "Dutch (Nederlands)" },
					{ "value": "pl", "label": "Polish (Polski)" },
					{ "value": "da", "label": "Danish (Dansk)" },
					{ "value": "sv", "label": "Swedish (Svenska)" },
					{ "value": "no", "label": "Norwegian (Norsk)" },
					{ "value": "fi", "label": "Finnish (Suomi)" }
				],
				"default": "en"
			},
			"primaryColor": {
				"type": "string",
				"label": "Widget Colour",
				"description": "Primary accent hex color for the widget button and active highlights (e.g. #1863DC).",
				"default": "#1863DC"
			},
			"iconId": {
				"type": "select",
				"label": "Launcher Icon",
				"description": "Visual icon displayed inside the floating launcher button.",
				"options": [
					{ "value": "default", "label": "Default (Coddle Access Figure)" },
					{ "value": "accessibility", "label": "Universal Access" },
					{ "value": "assist", "label": "Assist / Help" },
					{ "value": "wheel", "label": "Wheelchair" }
				],
				"default": "default"
			},
			"iconSize": {
				"type": "number",
				"label": "Button Size (px)",
				"description": "Diameter of the floating launcher button (40 = Small, 48 = Medium, 56 = Large).",
				"default": 48,
				"min": 24,
				"max": 80
			},
			"positionDesktop": {
				"type": "select",
				"label": "Desktop Screen Position",
				"description": "Placement of the floating button on desktop screens.",
				"options": [
					{ "value": "bottom-right", "label": "Bottom Right" },
					{ "value": "bottom-left", "label": "Bottom Left" },
					{ "value": "top-right", "label": "Top Right" },
					{ "value": "top-left", "label": "Top Left" }
				],
				"default": "bottom-right"
			},
			"positionMobile": {
				"type": "select",
				"label": "Mobile Screen Position",
				"description": "Placement of the floating button on mobile devices.",
				"options": [
					{ "value": "bottom-right", "label": "Bottom Right" },
					{ "value": "bottom-left", "label": "Bottom Left" },
					{ "value": "top-right", "label": "Top Right" },
					{ "value": "top-left", "label": "Top Left" }
				],
				"default": "bottom-right"
			},
			"statementUrl": {
				"type": "url",
				"label": "Accessibility Statement URL",
				"description": "Full URL or relative path to your website accessibility statement.",
				"default": "/accessibility-statement"
			}
		}
	},

	"release": {
		"requires": {
			"env:emdash": ">=0.12.0"
		},
		"artifacts": {
			"icon": {
				"file": "icon.png"
			},
			"screenshots": [
				{
					"file": "screenshots/coddle-access-menu.jpg"
				}
			]
		}
	},

	"sections": {
		"description": {
			"file": "docs/description.md"
		},
		"changelog": {
			"file": "CHANGELOG.md"
		}
	}
}
